# Open Slot settings. Copy to .env (git-ignored) and fill in locally; never commit .env.
# Every value below is empty on purpose: an empty value means "use the built-in default".
# To keep the key outside the repository instead, point at your own key file:
#   OPEN_SLOT_ENV_FILE=/path/to/qloo.env python3 -m open_slot serve

# Your own Qloo hackathon key. It only works against hackathon.api.qloo.com. Leave it empty to
# run on the synthetic sample data, with a banner on every page saying Qloo is not being called.
QLOO_API_KEY=

# Data provider: live (needs QLOO_API_KEY) or fake (synthetic sample data, no network).
# Empty means live when QLOO_API_KEY is set, else fake. A missing key never falls back silently.
OPEN_SLOT_PROVIDER=

# Most live Qloo calls one programme may spend (default 16). Only a person can raise it, up to 40.
OPEN_SLOT_MAX_CALLS=

# Most live Qloo calls, in any 24 hours, in plans the agent starts on its own for one workspace
# (default 48). Kept in memory, so it restarts with the server.
OPEN_SLOT_AGENT_CALLS_PER_DAY=

# Most live Qloo calls the whole server makes per UTC day (default 600). Set it from the quota
# your key's email states. Kept in memory and, where the host's disk lasts, in the git-ignored
# .cache directory; on a host that sleeps or loses its disk at a restart it restarts with the
# server, so there it bounds one run of the server, not a calendar day.
OPEN_SLOT_DAILY_LIVE_CALLS=

# Seconds a Qloo response stays in the private cache (default 86400).
OPEN_SLOT_CACHE_TTL_S=

# Seconds an idle workspace is kept before it is forgotten (default 7200). A host that sleeps or
# restarts forgets every workspace sooner, because they are held in memory only.
OPEN_SLOT_WORKSPACE_TTL_S=

# Address to bind (default 127.0.0.1). A host sets 0.0.0.0, and then needs an allowed host (below).
OPEN_SLOT_BIND=

# Comma-separated Host header values (no port) the server answers to, besides 127.0.0.1, localhost
# and [::1]. It is read whatever the bind is: behind a reverse proxy the server stays on 127.0.0.1
# and still receives the public name in Host. On Render the service's own RENDER_EXTERNAL_HOSTNAME
# is read automatically, so this can stay empty there. A non-loopback bind with no allowed host
# does not start.
OPEN_SLOT_ALLOWED_HOSTS=

# Set to 1 only behind a reverse proxy that appends the client address to X-Forwarded-For (a
# host's proxy does). The right-most value is then the client address used for the limit on
# creating workspaces; leave it empty on a local run, where the peer address is used.
OPEN_SLOT_TRUST_PROXY=

# Port to listen on (default 8760). A host's PORT, below, wins when it is set.
OPEN_SLOT_PORT=

# The port a host injects (Render: 10000). Leave it empty on your own machine.
PORT=
